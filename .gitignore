# Dependências Composer
/vendor/

# Storage de uploads, logs e sessões temporárias
/app/storage/uploads/*
!/app/storage/uploads/.gitkeep
/app/storage/logs/*
!/app/storage/logs/.gitkeep
/app/storage/sessions/*
!/app/storage/sessions/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
*.tmp
