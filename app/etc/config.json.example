{
  "app": {
    "name": "Zait Tiny Framework",
    "short_name": "ZTFramework",
    "version": "2.0.0",
    "env": "development",
    "debug": true,
    "url": "http://localhost",
    "timezone": "America/Sao_Paulo",
    "charset": "UTF-8"
  },
  "paths": {
    "root": "/",
    "app": "app",
    "controllers": "app/controllers",
    "models": "app/models",
    "views": "app/views",
    "storage": "app/storage",
    "public": "public",
    "routes": "app/etc/routes.json"
  },
  "security": {
    "password_pepper": "TROQUE_ESTE_PEPPER_SECRETO_EM_PRODUCAO_#2026",
    "bcrypt_cost": 12,
    "sessionName": "ZTSESSID",
    "sessionLifetime": 7200
  },
  "publicZone": {
    "enabled": true,
    "prefix": "/public",
    "cacheSeconds": 86400,
    "allowedMimes": {
      "html": "text/html; charset=utf-8",
      "css": "text/css; charset=utf-8",
      "js": "application/javascript; charset=utf-8",
      "json": "application/json; charset=utf-8",
      "png": "image/png",
      "jpg": "image/jpeg",
      "jpeg": "image/jpeg",
      "gif": "image/gif",
      "svg": "image/svg+xml",
      "ico": "image/x-icon",
      "mp3": "audio/mpeg",
      "wav": "audio/wav",
      "pdf": "application/pdf",
      "txt": "text/plain; charset=utf-8",
      "woff": "font/woff",
      "woff2": "font/woff2"
    }
  },
  "database": {
    "default": "mysql",
    "connections": {
      "mysql": {
        "driver": "mysql",
        "host": "localhost",
        "port": 3306,
        "dbname": "ztframework",
        "user": "SEU_USUARIO_MYSQL",
        "password": "SUA_SENHA_MYSQL",
        "charset": "utf8mb4"
      },
      "pgsql": {
        "driver": "pgsql",
        "host": "localhost",
        "port": 5432,
        "dbname": "ztframework",
        "user": "SEU_USUARIO_POSTGRES",
        "password": "SUA_SENHA_POSTGRES",
        "charset": "utf8"
      },
      "oracle": {
        "driver": "oci",
        "host": "localhost",
        "port": 1521,
        "dbname": "XEPDB1",
        "user": "SEU_USUARIO_ORACLE",
        "password": "SUA_SENHA_ORACLE",
        "charset": "AL32UTF8"
      },
      "db2": {
        "driver": "ibm",
        "host": "localhost",
        "port": 50000,
        "dbname": "SAMPLE",
        "user": "SEU_USUARIO_DB2",
        "password": "SUA_SENHA_DB2",
        "charset": "UTF-8"
      }
    }
  },
  "mail": {
    "enabled": true,
    "simulate_in_dev": true,
    "provider": "mailtrap",
    "host": "sandbox.smtp.mailtrap.io",
    "port": 2525,
    "auth": true,
    "user": "SEU_USUARIO_SMTP_OU_MAILTRAP",
    "password": "SUA_SENHA_SMTP_OU_MAILTRAP",
    "encryption": "tls",
    "from_name": "Zait Tiny Framework 2.0"
  },
  "sms": {
    "enabled": true,
    "simulate_in_dev": true,
    "provider": "twilio",
    "twilio": {
      "account_sid": "AC_SEU_TWILIO_ACCOUNT_SID",
      "auth_token": "SEU_TWILIO_AUTH_TOKEN",
      "from_number": "+10000000000"
    }
  },
  "cors": {
    "default_enable": false,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With", "Accept"]
  }
}
