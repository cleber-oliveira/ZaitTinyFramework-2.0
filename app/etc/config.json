{
  "app": {
    "name": "ZTFramework",
    "version": "2.0.0",
    "env": "development",
    "debug": true,
    "url": "http://localhost",
    "timezone": "America/Sao_Paulo",
    "charset": "UTF-8"
  },
  "paths": {
    "root": "/",
    "app": "app",
    "controllers": "app/controllers",
    "models": "app/models",
    "views": "app/views",
    "storage": "app/storage",
    "public": "public",
    "routes": "app/etc/routes.json"
  },
  "security": {
    "password_pepper": "ZTFramework_Secur3_P3pp3r_#2026!@K9",
    "bcrypt_cost": 12,
    "sessionName": "ZTSESSID",
    "sessionLifetime": 7200
  },
  "publicZone": {
    "enabled": true,
    "prefix": "/public",
    "cacheSeconds": 86400,
    "allowedMimes": {
      "css": "text/css; charset=utf-8",
      "js": "application/javascript; charset=utf-8",
      "json": "application/json; charset=utf-8",
      "png": "image/png",
      "jpg": "image/jpeg",
      "jpeg": "image/jpeg",
      "gif": "image/gif",
      "svg": "image/svg+xml",
      "ico": "image/x-icon",
      "mp3": "audio/mpeg",
      "wav": "audio/wav",
      "pdf": "application/pdf",
      "txt": "text/plain; charset=utf-8",
      "woff": "font/woff",
      "woff2": "font/woff2"
    }
  },
  "database": {
    "default": "mysql",
    "connections": {
      "mysql": {
        "driver": "mysql",
        "host": "localhost",
        "port": 3306,
        "dbname": "ztframework",
        "user": "root",
        "password": "senha",
        "charset": "utf8mb4"
      },
      "pgsql": {
        "driver": "pgsql",
        "host": "localhost",
        "port": 5432,
        "dbname": "ztframework",
        "user": "postgres",
        "password": "",
        "charset": "utf8"
      }
    }
  },
  "mail": {
    "enabled": true,
    "simulate_in_dev": true,
    "host": "smtp.gmail.com",
    "port": 587,
    "auth": true,
    "user": "contato@ztframework.local",
    "password": "",
    "from_name": "ZTFramework Suporte"
  },
  "cors": {
    "default_enable": false,
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With", "Accept"]
  }
}
