@startuml PasswordSecurity
title ZTFramework 2.0 - Fluxo Criptográfico de Senhas (BCrypt + Salt + Pepper)

start

:Usuário digita a senha em texto plano;

partition "Camada 1: Proteção Pepper (HMAC-SHA256)" {
  :Obtém 'security.password_pepper' do config.json;
  :Executa hash_hmac('sha256', senha, pepper);
  note right
    - Remove limite de 72 bytes do BCrypt
    - Impede quebra de hash mesmo se o banco vazar
  end note
}

partition "Camada 2: Proteção Salt + BCrypt" {
  :Gera Salt criptográfico aleatório único de 16 bytes;
  :Aplica algoritmo BCrypt com 'bcrypt_cost' (ex: 12);
  :Gera hash final de 60 caracteres ($2y$12$...);
}

:Armazena Hash Final na tabela 'usuarios';

stop
@enduml
